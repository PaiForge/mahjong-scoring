# === Site URL ===
# Used for auth callback redirects (email confirmation, password reset),
# canonical URLs, sitemap.xml and robots.txt.
# Unset / empty / invalid values fall back to the production URL
# (https://score.mahjong.help — see src/config.ts), so local development
# MUST set this to localhost or auth emails will link to production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics (Optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# === Supabase ===
# Get these from your Supabase project: Settings -> API
# For local development: run `pnpm supabase start` (from apps/web) and use the local values
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Admin API (server-side only) — get from Supabase project: Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=

# === Database (Drizzle ORM) ===
# For local development: default connects to Supabase local PostgreSQL
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# POSTGRES_URL_NON_POOLING=  # Direct connection for drizzle-kit (production)

# === Stripe ===
STRIPE_PRICE_ID_PRO_PASS=
STRIPE_PRICE_ID_PRO_LIFETIME=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


# === App Store in-app purchases (iOS app) ===
# Both product IDs must be set for the app to sell Pro (and to apply the iOS
# practice quota). See apps/mobile/README.md "アプリ内課金（iOS）".
APPLE_IAP_PRODUCT_ID_PRO_PASS=help.mahjong.score.pro.pass30days
APPLE_IAP_PRODUCT_ID_PRO_LIFETIME=help.mahjong.score.pro.lifetime

# Numeric App Store Connect app ID (= ascAppId in apps/mobile/eas.json)
APPLE_IAP_APP_APPLE_ID=6820905974
# Comma-separated user_ids whose Sandbox (TestFlight / App Review / dev build)
# purchases are recorded. Others are rejected.
APPLE_IAP_SANDBOX_USER_IDS=

