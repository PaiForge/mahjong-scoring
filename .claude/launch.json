{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "web", "dev"],
      "port": 3000
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd apps/mobile && CI=1 npx expo start --web --port 8099 --clear"
      ],
      "port": 8099
    }
  ]
}
