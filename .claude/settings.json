{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(bash scripts/claude-cloud/stack-up.sh:*)",
      "Bash(bash scripts/claude-cloud/screenshot.sh:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/claude-cloud/session-start.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
